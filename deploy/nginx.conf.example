# Nginx 反向代理示例：让浏览器通过 HTTPS 访问，并正确升级 WebSocket
#
# 浏览器只在「HTTPS 或 localhost」下允许麦克风/摄像头，因此局域网或公网部署
# 必须配置 TLS，否则 getUserMedia 会直接失败。
#
# 使用前替换：server_name、证书路径、上游端口。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream moss_live {
    server 127.0.0.1:8000;
    keepalive 32;
}

server {
    listen 80;
    server_name moss.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name moss.example.com;

    ssl_certificate     /etc/letsencrypt/live/moss.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/moss.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # 访问口令（可选）：需要与服务端 APP_ACCESS_CODE 一致
    # set $moss_code "your-code";

    location / {
        proxy_pass http://moss_live;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
    }

    location /ws/realtime {
        proxy_pass http://moss_live;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }
}
