# Linux systemd 服务示例
#   sudo cp deploy/moss-live.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now moss-live
[Unit]
Description=MOSS Live realtime demo (FastAPI relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=moss
Group=moss
WorkingDirectory=/opt/moss
EnvironmentFile=/opt/moss/.env
ExecStart=/opt/moss/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
# 加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
