# 复制为 .env 后填入真实值：cp .env.example .env
MOSS_API_KEY=
MOSS_WS_ENDPOINT=wss://api.mosi.cn/v1/realtime
MOSS_REST_ENDPOINT=https://api.mosi.cn
MOSS_MODEL=moss-live-1.0
# 生成开场问候音频时用于合成“模拟用户语音”的 TTS 模型
MOSS_TTS_MODEL=moss-tts-1.5-flash

APP_HOST=127.0.0.1
APP_PORT=8000
APP_ACCESS_CODE=
APP_LOG_LEVEL=INFO
APP_LOG_EVENTS=false
# 接通后是否播放开场问候（需要先运行 scripts/gen_greeting.py 生成音频）
APP_GREETING_ENABLED=true
APP_GREETING_DELAY_MS=400

MAX_BINARY_FRAME=524288
MAX_SESSION_SECONDS=1800
MAX_TEXT_MESSAGE=65536
UPSTREAM_OPEN_TIMEOUT=15
